{
  "name": "mpp-inspector",
  "owner": {
    "name": "MPP Inspector Contributors",
    "email": "amgb20@github.com"
  },
  "metadata": {
    "description": "Machine Payments Protocol debugging and inspection tools for Claude Code",
    "version": "0.1.1"
  },
  "plugins": [
    {
      "name": "mpp-inspector",
      "source": {
        "source": "npm",
        "package": "@mpp-inspector/plugin",
        "version": "0.1.1"
      },
      "description": "Inspect, debug, and test Machine Payments Protocol (HTTP 402) endpoints directly from Claude Code",
      "version": "0.1.1",
      "author": {
        "name": "MPP Inspector Contributors"
      },
      "homepage": "https://github.com/amgb20/MPP-Inspector",
      "repository": "https://github.com/amgb20/MPP-Inspector",
      "license": "MIT",
      "keywords": ["mpp", "http-402", "payments", "web3", "tempo", "mcp", "debugging"],
      "category": "web3",
      "tags": ["payments", "protocol", "blockchain", "api-debugging", "devtools"],
      "commands": ["./skills/"],
      "mcpServers": {
        "mpp-inspector": {
          "command": "node",
          "args": ["${CLAUDE_PLUGIN_ROOT}/dist/index.js"]
        }
      },
      "hooks": "./hooks/hooks.json"
    }
  ]
}
